---
// Short enquiry form (Netlify Forms "enquiry" + /api/form for the emails). Only name and email are required.
import { UI } from '../../lib/c-i18n.js';
import FormSend from '../FormSend.astro';
const { lang = 'cs', services = [], selected = '' } = Astro.props;
const t = UI[lang]; const f = t.f;
const action = lang === 'cs' ? '/sluzby/dekuji' : '/en/services/thank-you';
const opt = `(${f.optional})`;
---
<section id="poptavka" class="band">
  <div class="w sec formwrap">
    <div class="rv" style="display: flex; flex-direction: column; gap: 14px">
      <h2 class="h2">{t.formTitle}</h2>
      <p class="ink2" style="max-width: 24rem">{t.formLead}</p>
    </div>
    <form class="form rv" id="enquiry-form" name="enquiry" method="POST" action={action} data-netlify="true" netlify-honeypot="website" style="--d: .1s">
      <input type="hidden" name="form-name" value="enquiry" />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="page" value={Astro.url.pathname} />
      <p class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></p>
      <fieldset class="chips full">
        <legend>{f.service}</legend>
        {services.map((s) => <label class="chip"><input type="radio" name="service" value={s.data.title[lang]} checked={s.id === selected} /><span>{s.data.title[lang]}</span></label>)}
        <label class="chip"><input type="radio" name="service" value={f.other} /><span>{f.other}</span></label>
      </fieldset>
      <label class="field">{f.name2}<input type="text" name="name" autocomplete="name" required /></label>
      <label class="field">{f.email}<input type="email" name="email" autocomplete="email" required /></label>
      <label class="field"><span>{f.date} <span class="opt">{opt}</span></span><input type="date" name="date" /></label>
      <label class="field"><span>{f.phone} <span class="opt">{opt}</span></span><input type="tel" name="phone" autocomplete="tel" /></label>
      <label class="field full"><span>{f.message} <span class="opt">{opt}</span></span><textarea name="note" placeholder={f.messagePh}></textarea></label>
      <div class="full" style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 4px">
        <p class="form-msg" role="alert" hidden style="flex-basis: 100%; color: #A3341F; font-weight: 500"></p>
        <button class="btn" type="submit">{f.send}</button>
        <span class="muted" style="font-size: 14px">{f.privacy} <a href="/privacy" style="color: var(--muted)">{f.privacyLink}</a></span>
      </div>
    </form>
  </div>
</section>
<FormSend form="#enquiry-form" error={lang === 'cs' ? 'Poptávku se nepodařilo odeslat. Zkuste to prosím znovu, nebo mi napište na zavatsky.v@seznam.cz.' : 'Your enquiry could not be sent. Please try again, or email me at zavatsky.v@seznam.cz.'} />
