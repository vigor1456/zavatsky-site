---
import { getCollection } from 'astro:content';
import CBase from '../../layouts/CBase.astro';
import Pic from '../Pic.astro';
import Reviews from './Reviews.astro';
import Enquiry from './Enquiry.astro';
import { UI, svcPath, BUSINESS_ID, listPrice } from '../../lib/c-i18n.js';
import { SITE, abs, describe } from '../../lib/site.js';
import { cdn, srcset } from '../../lib/img.js';
import { ar } from '../../lib/ar.js';

const { lang = 'cs', svc } = Astro.props;
const t = UI[lang];
const d = svc.data;
const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((s) => s.id !== svc.id);
const reviews = (await getCollection('reviews', ({ data }) => data.services.includes(svc.id)))
  .sort((a, b) => (a.data.lang === lang ? 0 : 1) - (b.data.lang === lang ? 0 : 1) || a.data.order - b.data.order).slice(0, 3);
const price = (s) => (lang === 'cs' ? s.data.price_czk : s.data.price_eur);
const o2 = d.offer2;
const o2price = o2 ? (lang === 'cs' ? o2.price_czk : o2.price_eur) : null;
const path = svcPath(lang, svc), altPath = svcPath(t.other, svc);
const linked = d.extra?.link_service ? all.find((s) => s.id === d.extra.link_service) : null;
const gallery = d.gallery.map((im) => ({ ...im, ar: ar(im.src) }));
const graph = [
  { '@type': 'Service', '@id': SITE + path + '#service', name: d.title[lang], serviceType: d.title[lang], description: d.intro[lang], url: SITE + path,
    provider: { '@id': BUSINESS_ID }, areaServed: [{ '@type': 'Country', name: 'Czech Republic' }, { '@type': 'Country', name: 'Slovakia' }],
    image: abs(d.hero.src),
    offers: [
      ...(price(svc) ? [{ '@type': 'Offer', priceCurrency: lang === 'cs' ? 'CZK' : 'EUR', price: price(svc), description: [d.offer_title?.[lang], d.example_label[lang]].filter(Boolean).join(': ') }] : []),
      ...(o2 && o2price ? [{ '@type': 'Offer', priceCurrency: lang === 'cs' ? 'CZK' : 'EUR', price: o2price, description: `${o2.title[lang]}: ${o2.example_label[lang]}` }] : []),
    ] },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumb, item: SITE + t.base },
    { '@type': 'ListItem', position: 2, name: d.title[lang], item: SITE + path } ] },
  ...(d.faqs.length ? [{ '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })) }] : []),
];
const check = '<path d="M5 12l4 4 10-10"></path>';
// Mosaic tiles repeat a 5-photo pattern; the last group adapts so the grid never ends with a gap.
const tile = (i) => {
  const n = gallery.length, full = n - (n % 5), r = n % 5, k = i - full;
  if (i < full || r === 3) return `m${(i % 5) + 1}`;
  if (r === 1) return 'mfull';
  if (r === 2) return 'm4';
  return k < 3 ? `m${k + 1}` : 'mfull';
};
---
<CBase lang={lang} title={d.seo_title[lang]} description={describe(d.seo_description[lang])} path={path} altPath={altPath}
  image={d.hero.src} imageAlt={d.hero.alt?.[lang]} graph={graph} viewer={gallery.length > 0} serviceId={svc.id} current="services">

  <section class="shero">
    <Pic src={d.hero.src} alt={d.hero.alt?.[lang] || ''} hero eager sizes="100vw" />
    <div class="w"><div class="panel rv">
      <nav class="crumb" style="margin-bottom: 18px" aria-label={lang === 'cs' ? 'Drobečková navigace' : 'Breadcrumb'}><a href={t.base}>{t.breadcrumb}</a> <span aria-hidden="true">/</span> {d.title[lang]}</nav>
      {d.tagline
        ? <h1 class="h1 xl" style="font-size: clamp(2.8rem, 5.4vw, 5.4rem)"><span class="pre">{d.h1[lang]}</span><span class="tag">{d.tagline[lang]}</span></h1>
        : <h1 class="h1 xl" style="font-size: clamp(2.6rem, 5.2vw, 5.2rem)">{d.h1[lang]}</h1>}
      <p class="lead" style="margin-top: 22px">{d.intro[lang]}</p>
      <div class="btns" style="margin-top: 24px">
        <a class="btn" href="#poptavka">{t.cta}</a>
        {gallery.length > 0 && <a class="btn line" href="#ukazky">{t.galleryTitle}</a>}
      </div>
    </div></div>
  </section>

  <section class="w sec">
    <div class="duo">
      <div>
        <h2 class="h2 rv">{d.timeline_title?.[lang] || t.timelineTitle}</h2>
        {d.timeline.length > 0 && (
          <ol class="vtrack">
            {d.timeline.map((x, i) => <li class={`node rv${i === d.timeline.length - 1 ? ' hi' : ''}`} style={`--d:${i * 0.12}s`}><span class="when">{x.when[lang]}</span><strong>{x.title[lang]}</strong><span>{x.text[lang]}</span></li>)}
          </ol>
        )}
      </div>
      <aside class="price rv" style="--d: .15s" aria-label={t.priceLabel}>
        {d.offer_title && <p class="offer-title">{d.offer_title[lang]}</p>}
        <p class="muted" style="font-size: 14px">{d.example_label[lang]}</p>
        {price(svc) && <p class="amount">{t.from} {t.currency(price(svc))}{d.price_unit && <span class="unit"> {d.price_unit[lang]}</span>}</p>}
        <ul>
          {d.includes[lang].map((x) => <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent)" set:html={check}></svg>{x}</li>)}
        </ul>
        <p class="note">{d.price_note[lang]}</p>
        <a class="btn" href="#poptavka">{t.cta}</a>
      </aside>
    </div>
  </section>

  {o2 && (
    <section class="band">
      <div class="w sec duo">
        <div class="rv" style="display: flex; flex-direction: column; gap: 18px">
          <h2 class="h2">{o2.title[lang]}</h2>
          {o2.text && <p class="lead">{o2.text[lang]}</p>}
          {o2.note && <p class="ink2">{o2.note[lang]}</p>}
        </div>
        <aside class="price rv" style="--d: .15s" aria-label={o2.title[lang]}>
          <p class="muted" style="font-size: 14px">{o2.example_label[lang]}</p>
          {o2price && <p class="amount">{t.from} {t.currency(o2price)}{o2.price_unit && <span class="unit"> {o2.price_unit[lang]}</span>}</p>}
          <ul>
            {o2.includes[lang].map((x) => <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent)" set:html={check}></svg>{x}</li>)}
          </ul>
          <a class="btn" href="#poptavka">{t.cta}</a>
        </aside>
      </div>
    </section>
  )}

  <Reviews reviews={reviews} title={t.reviewsTitle} note={reviews.some((r) => r.data.lang !== lang) ? t.reviewsNote : ''} lang={lang} />

  {gallery.length > 0 && (
    <section id="ukazky" class="w" style="padding-bottom: clamp(72px, 9vw, 120px)">
      <h2 class="h2 rv" style="margin-bottom: 28px">{t.galleryTitle}</h2>
      <div class="mosaic">
        {gallery.map((im, i) => (
          <figure class={`${tile(i)} rv`} style={`--d:${(i % 5) * 0.06}s`}>
            <button type="button" data-full={cdn(im.src, 2048)} aria-label={im.alt?.[lang] || d.title[lang]}>
              <img src={cdn(im.src, 1200)} srcset={srcset(im.src)} sizes={(i % 5) === 0 ? '(max-width: 860px) 100vw, 66vw' : '(max-width: 860px) 100vw, 50vw'} width={1000} height={Math.round(1000 / im.ar)} alt={im.alt?.[lang] || ''} loading="lazy" decoding="async" />
            </button>
          </figure>
        ))}
      </div>
    </section>
  )}

  {d.extra && (
    <section class="dark sec">
      <div class="w split rv">
        {d.extra.image && <Pic src={d.extra.image.src} alt={d.extra.image.alt?.[lang] || ''} sizes="(max-width: 860px) 100vw, 50vw" fallback={1200} />}
        <div style="display: flex; flex-direction: column; gap: 18px">
          <h2 class="h2" style="color: #fff">{d.extra.title[lang]}</h2>
          <p style="color: var(--on-dark); font-size: 18px">{d.extra.text[lang]}</p>
          {linked && <p style="color: var(--on-dark)">{d.extra.link_label?.[lang]} <a href={svcPath(lang, linked)}>{linked.data.title[lang]}</a></p>}
        </div>
      </div>
    </section>
  )}

  {d.faqs.length > 0 && (
    <section id="faq" class="w sec">
      <h2 class="h2 rv" style="margin-bottom: 28px">{t.faqTitle}</h2>
      <div class="faq">
        {d.faqs.map((f, i) => <details class="rv" style={`--d:${(i % 2) * 0.1}s`} open={i < 2}><summary>{f.q[lang]}</summary><p>{f.a[lang]}</p></details>)}
      </div>
    </section>
  )}

  <Enquiry lang={lang} services={all} selected={svc.id} />

  <section class="w" style="padding-top: clamp(56px, 7vw, 88px); padding-bottom: clamp(48px, 6vw, 72px)">
    <h2 class="muted" style="font-size: 15px; font-weight: 600; margin-bottom: 6px">{t.more}</h2>
    <div class="idx">
      {others.map((s, i) => (
        <a class="irow rv" href={svcPath(lang, s)} style={`--d:${i * 0.06}s`}>
          <Pic src={(s.data.card_image || s.data.hero).src} alt="" sizes="132px" fallback={480} />
          <h3>{s.data.title[lang]}</h3>
          <p>{s.data.card[lang]}</p>
          <span class="pr">{listPrice(s, lang).amount ? `${t.from} ${t.currency(listPrice(s, lang).amount)}${listPrice(s, lang).unit ? ' ' + listPrice(s, lang).unit : ''}` : ''}<span>{t.detail}</span></span>
        </a>
      ))}
    </div>
  </section>
</CBase>
