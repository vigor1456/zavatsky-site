---
import { getCollection, getEntry } from 'astro:content';
import CBase from '../../layouts/CBase.astro';
import Pic from '../Pic.astro';
import Reviews from './Reviews.astro';
import Enquiry from './Enquiry.astro';
import { UI, svcPath, BUSINESS_ID, listPrice } from '../../lib/c-i18n.js';
import { SITE, VZ, describe } from '../../lib/site.js';
import { ar } from '../../lib/ar.js';

const { lang = 'cs' } = Astro.props;
const t = UI[lang];
const hub = (await getEntry('commercial', 'hub')).data;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const reviews = (await getCollection('reviews', ({ data }) => data.on_hub)).sort((a, b) => (a.data.lang === lang ? 0 : 1) - (b.data.lang === lang ? 0 : 1) || a.data.order - b.data.order);
const price = (s) => (lang === 'cs' ? s.data.price_czk : s.data.price_eur);
const first = services[0];
const stripRatio = (src) => Math.min(1.5, Math.max(0.8, ar(src)));
const path = t.base, altPath = UI[t.other].base;
const graph = [
  { '@type': 'WebPage', '@id': SITE + path + '#page', url: SITE + path, name: hub.seo_title[lang], inLanguage: lang, about: { '@id': BUSINESS_ID } },
  { '@type': 'OfferCatalog', name: t.services, itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.data.title[lang], url: SITE + svcPath(lang, s) }, priceCurrency: lang === 'cs' ? 'CZK' : 'EUR', price: price(s) })) },
  { '@type': 'FAQPage', mainEntity: hub.faqs.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })) },
];
---
<CBase lang={lang} title={hub.seo_title[lang]} description={describe(hub.seo_description[lang])} path={path} altPath={altPath}
  image={hub.hero.src} imageAlt={hub.hero.alt?.[lang]} graph={graph} current="services">

  <section class="w c-open">
    <div class="rv" style="display: flex; flex-direction: column; gap: 18px">
      <p style="font-size: 15px; font-weight: 500; color: var(--accent)">{hub.eyebrow[lang]}</p>
      <h1 class="h1 xl">{hub.h1[lang]}</h1>
    </div>
    <div class="open-side rv" style="--d: .1s">
      <p class="ink2" style="font-size: 18px">{hub.lead[lang]}</p>
      <div class="btns">
        <a class="btn" href="#poptavka">{t.cta}</a>
        <a class="btn line" href={`tel:${VZ.tel}`}>{VZ.phone}</a>
      </div>
    </div>
  </section>

  <div class="strip rv" style="--d: .15s" aria-label={lang === 'cs' ? 'Ukázky práce podle služeb' : 'Work by service'}>
    {services.map((s, i) => {
      const im = s.data.card_image || s.data.hero; const r = stripRatio(im.src);
      return (
        <a href={svcPath(lang, s)} style={`--ar:${r};--arr:${r}`}>
          <Pic src={im.src} alt={im.alt?.[lang] || s.data.title[lang]} eager={i < 3} sizes="(max-width: 860px) 70vw, 28vw" fallback={1200} />
          <span class="cap"><strong>{s.data.title[lang]}</strong>{listPrice(s, lang).amount && <span>{t.from} {t.currency(listPrice(s, lang).amount)}{listPrice(s, lang).unit && ` ${listPrice(s, lang).unit}`}</span>}</span>
        </a>
      );
    })}
  </div>

  <div class="w facts2 rv">
    {hub.facts.map((f) => <span><strong>{f.title[lang]}</strong>{f.text[lang]}</span>)}
  </div>

  <Reviews reviews={reviews} title={t.reviewsTitle} note={t.reviewsNote} lang={lang} />

  <section id="sluzby" class="w" style="padding-bottom: clamp(72px, 9vw, 120px)">
    <div class="row-head">
      <h2 class="h2 rv">{lang === 'cs' ? 'Služby a ceny' : 'Services and prices'}</h2>
      <p class="ink2 rv" style="max-width: 26rem">{t.servicesLead}</p>
    </div>
    <div class="idx">
      {services.map((s, i) => (
        <a class="irow rv" href={svcPath(lang, s)} style={`--d:${i * 0.06}s`}>
          <Pic src={(s.data.card_image || s.data.hero).src} alt="" sizes="132px" fallback={480} />
          <h3>{s.data.title[lang]}</h3>
          <p>{s.data.card[lang]}</p>
          <span class="pr">{listPrice(s, lang).amount ? `${t.from} ${t.currency(listPrice(s, lang).amount)}${listPrice(s, lang).unit ? ' ' + listPrice(s, lang).unit : ''}` : ''}<span>{t.detail}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section id="jak" class="band">
    <div class="w sec">
      <h2 class="h2 rv">{lang === 'cs' ? 'Od poptávky k hotovým fotkám' : 'From enquiry to finished photos'}</h2>
      <ol class="track">
        {hub.steps.map((s, i) => (
          <li class={`node rv${i === hub.steps.length - 1 ? ' hi' : ''}`} style={`--d:${i * 0.12}s`}>
            {s.when && <span class="when">{s.when[lang]}</span>}<strong>{s.title[lang]}</strong><span>{s.text[lang]}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="dark sec">
    <div class="w">
      <h2 class="h2 rv" style="margin-bottom: 32px; font-size: clamp(2rem, 3.2vw, 2.8rem); color: #fff">{t.trustTitle}</h2>
      <ul class="trust">
        {hub.trust.map((x, i) => <li class="rv" style={`--d:${i * 0.1}s`}><strong>{x.title[lang]}</strong><span>{x.text[lang]}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="faq" class="w sec">
    <h2 class="h2 rv" style="margin-bottom: 28px">{t.faqTitle}</h2>
    <div class="faq">
      {hub.faqs.map((f, i) => <details class="rv" style={`--d:${(i % 2) * 0.1}s`} open={i < 2}><summary>{f.q[lang]}</summary><p>{f.a[lang]}</p></details>)}
    </div>
  </section>

  <Enquiry lang={lang} services={services} />
</CBase>
