---
// Terms of sale for prints (obchodní podmínky). DRAFT for legal review: kept out of search
// results (noindex) and unlinked until reviewed. Placeholders are marked [ … ].
import Base from '../layouts/Base.astro';
import { sections } from '../lib/terms.js';

const nav = [
  { href: '/prints', en: 'Prints', cs: 'Tisky' },
  { href: '/withdrawal', en: 'Withdrawal', cs: 'Odstoupení' },
  { href: '/ravique#contact', en: 'Contact', cs: 'Kontakt' },
];

---
<Base title="Terms of sale | Maximilian Ravique"
  description="Terms of sale for prints sold by Third Place Labs s.r.o.: ordering, payment, delivery, withdrawal and complaints."
  path="/terms" side="mr" mark="mr" nav={nav} footer="mr" noindex>
  <article class="wrap g12" style="padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(56px, 8vw, 120px)">
    <div class="prose" style="grid-column: 3 / span 8">
      <h1 class="display" style="font-size: clamp(2.6rem, 5vw, 4.4rem); margin-bottom: 0.6em" data-en="Terms of sale" data-cs="Obchodní podmínky">Terms of sale</h1>
      {sections.map((s) => (
        <Fragment>
          <h2 data-en={s.h.en} data-cs={s.h.cs}>{s.h.en}</h2>
          {s.p.map((x) => <p data-en={x.en} data-cs={x.cs}>{x.en}</p>)}
        </Fragment>
      ))}
    </div>
  </article>
</Base>
