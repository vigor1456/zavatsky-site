---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { SITE, abs, describe } from '../../lib/site.js';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const fmt = (x) => new Date(x).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const mr = d.author === 'MR';
const who = mr ? 'Maximilian Ravique' : 'Vadim Zavatsky';
const image = d.hero || d.cover;
const nav = [
  { href: '/people', en: 'People' },
  { href: '/ravique', en: 'Ravique' },
  { href: '/blog', en: 'Journal', current: true },
];
const graph = [{
  '@type': 'BlogPosting', '@id': `${SITE}/blog/${post.slug}#post`, url: `${SITE}/blog/${post.slug}`,
  headline: d.title, description: d.excerpt || '', inLanguage: 'en',
  datePublished: d.date.toISOString().slice(0, 10),
  image: image ? abs(image) : undefined,
  author: mr ? { '@type': 'Person', name: 'Maximilian Ravique', url: SITE + '/ravique' } : { '@id': SITE + '/#vadim' },
  publisher: { '@id': SITE + '/#vadim' },
  isPartOf: { '@id': SITE + '/blog#blog' },
}];
---
<Base title={`${d.title} | Journal`} description={describe(d.excerpt || d.title)} path={`/blog/${post.slug}`}
  image={image} side={mr ? 'mr' : 'vz'} mark="both" nav={nav} lang={false} footer={mr ? 'mr' : 'vz'} graph={graph} ogType="article">
  <article>
    <header class="wrap g12" style="padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(40px, 5vw, 72px); align-items: end">
      <h1 class="display" style="grid-column: 1 / span 8; font-size: clamp(2.8rem, 5.6vw, 5.6rem); line-height: 1">{d.title}</h1>
      <p class="small" style="grid-column: 10 / span 3; display: flex; flex-direction: column; line-height: 1.5">
        <span style="color: var(--paper)">{d.category}</span>
        <span class="muted">{fmt(d.date)}</span>
        <span class="muted">{who}</span>
      </p>
    </header>
    {image && (
      <div class="wrap" style="padding-inline: var(--pad)">
        <Pic src={image} class="cover" eager sizes="(max-width: 1680px) 100vw, 1680px" style="margin-inline: auto" alt={d.title} />
      </div>
    )}
    <div class="wrap g12" style="padding-top: clamp(56px, 7vw, 104px)">
      <div class="prose" style="grid-column: 3 / span 7"><Content /></div>
    </div>
    <div class="wrap center" style="padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(40px, 6vw, 80px)">
      <a class="tlink sm" href="/blog">Back to the Journal</a>
    </div>
  </article>
</Base>
