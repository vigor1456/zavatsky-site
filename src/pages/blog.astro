---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { SITE } from '../lib/site.js';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.date - a.data.date);
const [feat, ...rest] = posts;
const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const who = (a) => (a === 'MR' ? 'Maximilian Ravique' : 'Vadim Zavatsky');
const nav = [
  { href: '/people', en: 'People' },
  { href: '/ravique', en: 'Ravique' },
  { href: '/blog', en: 'Journal', current: true },
];
const graph = [{ '@type': 'Blog', '@id': SITE + '/blog#blog', url: SITE + '/blog', name: 'Journal', inLanguage: 'en',
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE}/blog/${p.slug}`, datePublished: p.data.date.toISOString().slice(0, 10) })) }];
---
<Base title="Journal | Vadim Zavatsky & Maximilian Ravique"
  description="Notes from behind the camera, from both sides of the work: shoots, travels and the odd new set of prints, by Vadim Zavatsky and Maximilian Ravique."
  path="/blog" image={feat?.data.cover || '/images/hero-ravique.jpg'} side="vz" mark="both" nav={nav} lang={false} footer="vz" graph={graph}>

  <header class="wrap g12" style="padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(56px, 7vw, 104px); align-items: end">
    <h1 class="display" style="grid-column: 1 / span 6">Journal</h1>
    <p class="lead" style="grid-column: 8 / span 5">Notes from behind the camera, from both sides of the work. Shoots, travels, and the odd new set of prints.</p>
  </header>

  {feat && (
    <section class="wrap g12" style="align-items: end">
      <a class="bl rv" href={`/blog/${feat.slug}`} style="grid-column: 1 / span 8" tabindex="-1" aria-hidden="true">
        <Pic src={feat.data.cover || feat.data.hero} class="cover" sizes="(max-width: 760px) 100vw, 66vw" alt="" />
      </a>
      <div class={`rv cap side-${feat.data.author === 'MR' ? 'mr' : 'vz'}`} style="grid-column: 9 / span 4">
        <p class="small" style="display: flex; flex-direction: column; line-height: 1.5">
          <span style="color: var(--paper)">{feat.data.category}</span>
          <span class="muted">{fmt(feat.data.date)}, {who(feat.data.author)}</span>
        </p>
        <a class="tlink" href={`/blog/${feat.slug}`} style="align-self: flex-start; line-height: 1.05">{feat.data.title}</a>
        {feat.data.excerpt && <p class="small">{feat.data.excerpt}</p>}
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="wrap g12" style="padding-top: clamp(96px, 12vw, 180px); row-gap: clamp(72px, 9vw, 120px); align-items: start">
      {rest.map((p, i) => (
        <article class={`rv side-${p.data.author === 'MR' ? 'mr' : 'vz'}`} style={i % 2 === 0 ? 'grid-column: 2 / span 5' : 'grid-column: 8 / span 5; margin-top: clamp(80px, 10vw, 160px)'}>
          <a href={`/blog/${p.slug}`} tabindex="-1" aria-hidden="true"><Pic src={p.data.cover || p.data.hero} class="cover" sizes="(max-width: 760px) 100vw, 40vw" alt="" /></a>
          <div class="cap">
            <p class="small" style="display: flex; flex-direction: column; line-height: 1.5">
              <span style="color: var(--paper)">{p.data.category}</span>
              <span class="muted">{fmt(p.data.date)}, {who(p.data.author)}</span>
            </p>
            <a class="tlink sm" href={`/blog/${p.slug}`} style="align-self: flex-start; line-height: 1.1">{p.data.title}</a>
            {p.data.excerpt && <p class="small">{p.data.excerpt}</p>}
          </div>
        </article>
      ))}
    </section>
  )}
  <div style="height: clamp(80px, 10vw, 140px)"></div>
</Base>
