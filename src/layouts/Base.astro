---
import '@fontsource-variable/league-gothic';
import '@fontsource-variable/libre-franklin';
import '@fontsource-variable/libre-franklin/wght-italic.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import Viewer from '../components/Viewer.astro';
import { SITE, abs, personGraph } from '../lib/site.js';

const {
  title, description, path = '/', image = '/images/hero-people.jpg', imageAlt = '',
  side = 'vz', mark = 'vz', nav = [], lang = true,
  footer = 'vz', footerId, graph = [], viewer = false, ogType = 'website', noindex = false,
} = Astro.props;
const canonical = SITE + path;
const ld = { '@context': 'https://schema.org', '@graph': [...personGraph(), ...graph] };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="tdm-reservation" content="1">
<meta name="robots" content="noai, noimageai">
<script is:inline>
  // The opening "developing print" plays once per visit for each page.
  try { var k = 'dev:' + location.pathname; if (sessionStorage.getItem(k)) document.documentElement.classList.add('seen'); else sessionStorage.setItem(k, '1'); } catch (e) {}
</script>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#121212">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Vadim Zavatsky & Maximilian Ravique">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={abs(image)}>
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="Journal" href="/rss.xml">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={`side-${side}`}>
<a class="skip" href="#main">Skip to content</a>
<Header mark={mark} nav={nav} lang={lang} />
<main id="main">
  <slot />
</main>
<Footer side={footer} id={footerId} />



{lang && (
<script is:inline>
(function(){
  var KEY='site_lang', btn=document.getElementById('lang');
  var lang='en'; try{ lang=localStorage.getItem(KEY)||'en'; }catch(e){}
  function apply(){
    document.documentElement.lang=lang;
    document.querySelectorAll('[data-en]').forEach(function(el){
      var v=el.getAttribute(lang==='en'?'data-en':'data-cs'); if(v!=null){ if(lang==='cs') v=v.replace(/(^|[\s(„“"])([ksvzouaiKSVZOUAI])\s+(?=\S)/g,'$1$2\u00a0').replace(/(^|[\s(„“"])([ksvzouaiKSVZOUAI])\s+(?=\S)/g,'$1$2\u00a0'); el.innerHTML=v; }
    });
    document.querySelectorAll('[data-alt-cs]').forEach(function(el){
      el.alt=el.getAttribute(lang==='en'?'data-alt-en':'data-alt-cs');
    });
    if(btn) btn.innerHTML = lang==='en' ? '<b>EN</b> / CS' : 'EN / <b>CS</b>';
    document.dispatchEvent(new Event('langchange'));
  }
  if(btn) btn.addEventListener('click',function(){ lang = lang==='en'?'cs':'en'; try{localStorage.setItem(KEY,lang);}catch(e){} apply(); });
  if(lang!=='en') apply();
})();
</script>
)}

<script is:inline>
// Highlight the header link of the section currently on screen.
(function(){
  var links=[].slice.call(document.querySelectorAll('.nav a[href*="#"]'));
  var map=links.map(function(a){ var id=a.getAttribute('href').split('#')[1]; var el=id&&document.getElementById(id); return el?{a:a,el:el}:null; }).filter(Boolean);
  if(!map.length||!('IntersectionObserver' in window)) return;
  var vis={};
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){ vis[e.target.id]=e.isIntersecting; });
    var cur=null; map.forEach(function(m){ if(vis[m.el.id]&&!cur) cur=m; });
    map.forEach(function(m){ if(m===cur) m.a.setAttribute('aria-current','true'); else m.a.removeAttribute('aria-current'); });
  },{rootMargin:'-30% 0px -55% 0px'});
  map.forEach(function(m){ io.observe(m.el); });
})();
</script>

{viewer && <Viewer />}
<Consent />
</body>
</html>
