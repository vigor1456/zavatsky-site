---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { SITE, abs, personGraph } from '../lib/site.js';

const {
  title, description, path = '/', image = '/images/hero-people.jpg', imageAlt = '',
  side = 'vz', mark = 'vz', nav = [], lang = true,
  footer = 'vz', footerId, graph = [], viewer = false, ogType = 'website',
} = Astro.props;
const canonical = SITE + path;
const ld = { '@context': 'https://schema.org', '@graph': [...personGraph(), ...graph] };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#121212">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Vadim Zavatsky & Maximilian Ravique">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={abs(image)}>
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="Journal" href="/rss.xml">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={`side-${side}`}>
<a class="skip" href="#main">Skip to content</a>
<Header mark={mark} nav={nav} lang={lang} />
<main id="main">
  <slot />
</main>
<Footer side={footer} id={footerId} />

{viewer && (
  <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="v-bar">
      <span class="v-count" id="v-count"></span>
      <button class="v-btn plain" id="v-close" type="button" aria-label="Close viewer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
    <div class="v-stage" id="v-stage"><img id="v-img" alt="" /></div>
    <div class="v-foot">
      <button class="v-btn" id="v-prev" type="button" aria-label="Previous photo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <p class="v-alt" id="v-alt"></p>
      <button class="v-btn" id="v-next" type="button" aria-label="Next photo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
)}

{lang && (
<script is:inline>
(function(){
  var KEY='site_lang', btn=document.getElementById('lang');
  var lang='en'; try{ lang=localStorage.getItem(KEY)||'en'; }catch(e){}
  function apply(){
    document.documentElement.lang=lang;
    document.querySelectorAll('[data-en]').forEach(function(el){
      var v=el.getAttribute(lang==='en'?'data-en':'data-cs'); if(v!=null) el.innerHTML=v;
    });
    document.querySelectorAll('[data-alt-cs]').forEach(function(el){
      el.alt=el.getAttribute(lang==='en'?'data-alt-en':'data-alt-cs');
    });
    if(btn) btn.innerHTML = lang==='en' ? '<b>EN</b> / CS' : 'EN / <b>CS</b>';
    document.dispatchEvent(new Event('langchange'));
  }
  if(btn) btn.addEventListener('click',function(){ lang = lang==='en'?'cs':'en'; try{localStorage.setItem(KEY,lang);}catch(e){} apply(); });
  if(lang!=='en') apply();
})();
</script>
)}

<script is:inline>
// Highlight the header link of the section currently on screen.
(function(){
  var links=[].slice.call(document.querySelectorAll('.nav a[href*="#"]'));
  var map=links.map(function(a){ var id=a.getAttribute('href').split('#')[1]; var el=id&&document.getElementById(id); return el?{a:a,el:el}:null; }).filter(Boolean);
  if(!map.length||!('IntersectionObserver' in window)) return;
  var vis={};
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){ vis[e.target.id]=e.isIntersecting; });
    var cur=null; map.forEach(function(m){ if(vis[m.el.id]&&!cur) cur=m; });
    map.forEach(function(m){ if(m===cur) m.a.setAttribute('aria-current','true'); else m.a.removeAttribute('aria-current'); });
  },{rootMargin:'-30% 0px -55% 0px'});
  map.forEach(function(m){ io.observe(m.el); });
})();
</script>

{viewer && (
<script is:inline>
// Justified rows: photos keep their own shape, no row is ever taller than 85% of the window.
(function(){
  var GAP=8;
  function lay(g){
    var W=g.clientWidth-parseFloat(getComputedStyle(g).paddingLeft)-parseFloat(getComputedStyle(g).paddingRight);
    if(W<=0) return;
    var figs=[].slice.call(g.querySelectorAll('figure'));
    var maxH=Math.round(window.innerHeight*0.85);
    var target=W<600?0:Math.max(240,Math.min(440,W*0.22));
    function set(f,h){ var a=+f.dataset.ar; f.style.width=(a*h).toFixed(1)+'px'; f.style.height=h.toFixed(1)+'px';
      var img=f.querySelector('img'); if(img) img.sizes=Math.ceil(a*h)+'px'; }
    if(!target){ figs.forEach(function(f){ var a=+f.dataset.ar; set(f,Math.min(W/a,maxH)); }); g.classList.add('laid'); return; }
    var row=[], sum=0;
    figs.forEach(function(f){
      row.push(f); sum+=+f.dataset.ar;
      if(sum*target+GAP*(row.length-1)>=W){
        var h=Math.min((W-GAP*(row.length-1))/sum,maxH);
        row.forEach(function(r){ set(r,h); }); row=[]; sum=0;
      }
    });
    if(row.length){ var h=Math.min(target,maxH); row.forEach(function(r){ set(r,h); }); }
    g.classList.add('laid');
  }
  var gs=[].slice.call(document.querySelectorAll('.jg'));
  function all(){ gs.forEach(lay); }
  all(); var t; window.addEventListener('resize',function(){ clearTimeout(t); t=setTimeout(all,120); });
  if(document.fonts) document.fonts.ready.then(all);

  // Full-screen viewer
  var v=document.getElementById('viewer'); if(!v) return;
  var items=[].slice.call(document.querySelectorAll('.jg figure button'));
  var img=document.getElementById('v-img'), cnt=document.getElementById('v-count'), alt=document.getElementById('v-alt');
  var i=0, opener=null, x0=null;
  function show(n){
    i=(n+items.length)%items.length; var b=items[i], s=b.querySelector('img');
    img.src=b.dataset.full; img.alt=s.alt; alt.textContent=s.alt;
    cnt.textContent=(i+1)+' / '+items.length;
    var nx=items[(i+1)%items.length]; if(nx){ var p=new Image(); p.src=nx.dataset.full; }
  }
  function open(n){ opener=items[n]; show(n); v.classList.add('open'); document.body.classList.add('v-lock'); document.getElementById('v-close').focus(); }
  function close(){ v.classList.remove('open'); document.body.classList.remove('v-lock'); img.removeAttribute('src'); if(opener) opener.focus(); }
  items.forEach(function(b,n){ b.addEventListener('click',function(){ open(n); }); });
  document.getElementById('v-close').onclick=close;
  document.getElementById('v-prev').onclick=function(){ show(i-1); };
  document.getElementById('v-next').onclick=function(){ show(i+1); };
  v.addEventListener('keydown',function(e){
    if(e.key==='Escape') close();
    else if(e.key==='ArrowLeft') show(i-1);
    else if(e.key==='ArrowRight') show(i+1);
    else if(e.key==='Tab'){ var f=[].slice.call(v.querySelectorAll('button')); var k=f.indexOf(document.activeElement);
      if(e.shiftKey&&k<=0){ e.preventDefault(); f[f.length-1].focus(); } else if(!e.shiftKey&&k===f.length-1){ e.preventDefault(); f[0].focus(); } }
  });
  var st=document.getElementById('v-stage');
  st.addEventListener('touchstart',function(e){ x0=e.touches[0].clientX; },{passive:true});
  st.addEventListener('touchend',function(e){ if(x0===null) return; var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>50) show(dx<0?i+1:i-1); x0=null; });
  st.addEventListener('click',function(e){ if(e.target===st) close(); });
})();
</script>
)}
<Consent />
</body>
</html>
