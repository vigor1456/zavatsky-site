---
// Layout for the commercial section: light theme, separate language pages (cs / en), linked for Google.
import '@fontsource-variable/brygada-1918';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/commercial.css';
import Consent from '../components/Consent.astro';
import Viewer from '../components/Viewer.astro';
import { SITE, abs, VZ } from '../lib/site.js';
import { UI, BUSINESS_ID, svcPath, listPrice, cz } from '../lib/c-i18n.js';
import { getCollection } from 'astro:content';

const { lang = 'cs', title, description, path, altPath, image = '/images/commercial/event-host.jpg', imageAlt = '', graph = [], current = '', noindex = false, viewer = false, serviceId = '' } = Astro.props;
const t = UI[lang];
const menuServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).map((x) => ({ ...x, data: cz(x.data) }));
const menuPrice = (x) => (lang === 'cs' ? x.data.price_czk : x.data.price_eur);
const csPath = lang === 'cs' ? path : altPath;
const enPath = lang === 'en' ? path : altPath;
const business = {
  '@type': 'ProfessionalService', '@id': BUSINESS_ID,
  name: 'Vadim Zavatsky, fotograf', alternateName: 'Vadim Zavatsky Photography',
  url: SITE + '/sluzby', image: abs('/images/commercial/event-host.jpg'),
  telephone: VZ.tel, email: VZ.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Školská 660/3', postalCode: '110 00', addressLocality: 'Praha', addressCountry: 'CZ' },
  areaServed: [{ '@type': 'Country', name: 'Czech Republic' }, { '@type': 'Country', name: 'Slovakia' }],
  founder: { '@id': SITE + '/#vadim' }, priceRange: '6 000–15 000+ Kč',
  legalName: 'Third Place Labs s.r.o.', taxID: '24501212',
};
const ld = { '@context': 'https://schema.org', '@graph': [business, ...graph] };
const nav = [
  { href: `${t.base}#jak`, label: t.how, key: 'how' },
  { href: `${t.base}#reference`, label: t.reviews, key: 'reviews' },
  { href: '#faq', label: t.faq, key: 'faq' },
];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={SITE + path}>
<meta name="tdm-reservation" content="1">
<meta name="robots" content="noai, noimageai">
{noindex && <meta name="robots" content="noindex">}
{csPath && <link rel="alternate" hreflang="cs" href={SITE + csPath}>}
{enPath && <link rel="alternate" hreflang="en" href={SITE + enPath}>}
{csPath && <link rel="alternate" hreflang="x-default" href={SITE + csPath}>}
<meta name="theme-color" content="#ECEFF1">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={SITE + path}>
<meta property="og:image" content={abs(image)}>
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class="cm">
<script is:inline>document.documentElement.classList.add('js');</script>
<a class="skip" href="#main">{lang === 'cs' ? 'Přeskočit na obsah' : 'Skip to content'}</a>
<header class="ch">
  <div class="ch-in">
    <a class="ch-mark" href={t.base} aria-label="Vadim Zavatsky">VZ<span>.</span></a>
    <nav aria-label={lang === 'cs' ? 'Hlavní' : 'Main'}>
      <div class="ch-menu">
        <button type="button" class="ch-mbtn" aria-expanded="false" aria-controls="ch-panel" aria-current={current === 'services' ? 'page' : undefined}>
          {t.services}<svg aria-hidden="true" width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 1.5l5 5 5-5"></path></svg>
        </button>
        <div class="ch-panel" id="ch-panel" hidden>
          <ul class="ch-svcs">
            {menuServices.map((x) => (
              <li><a href={svcPath(lang, x)} aria-current={serviceId === x.id ? 'page' : undefined}>
                <span>{x.data.title[lang]}</span>{listPrice(x, lang).amount && <span class="ch-p">{t.from} {t.currency(listPrice(x, lang).amount)}{listPrice(x, lang).unit && ` ${listPrice(x, lang).unit}`}</span>}
              </a></li>
            ))}
          </ul>
          <a class="ch-all" href={t.base}>{lang === 'cs' ? 'Všechny služby' : 'All services'}</a>
          <div class="ch-mlinks">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
            {altPath && <a class="ch-mlang" href={altPath} hreflang={t.other} lang={t.other}>{t.lang}</a>}
          </div>
        </div>
      </div>
      <span class="ch-links">
        {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
      </span>
      {altPath && <a class="ch-lang" href={altPath} hreflang={t.other} lang={t.other}>{t.lang}</a>}
      <a class="btn sm" href="#poptavka">{t.cta}</a>
    </nav>
  </div>
</header>
<main id="main"><slot /></main>
<footer class="cf">
  <div class="cf-in">
    <span>Vadim Zavatsky, {lang === 'cs' ? 'Praha' : 'Prague'}. <a href={`mailto:${VZ.email}`}>{VZ.email}</a>, <a href={`tel:${VZ.tel}`}>{VZ.phone}</a></span>
    <span>{t.company}. {lang === 'cs' ? 'Neplátce DPH.' : 'Not a VAT payer.'}</span>
    <span><a id="cc-privfoot" href="/privacy">{t.privacyFooter}</a>, <a id="cc-settings" href="#cookies">{t.cookie}</a></span>
    <span style="flex-basis: 100%">© {new Date().getFullYear()} Vadim Zavatsky. {lang === 'cs' ? 'Všechna práva vyhrazena. Fotografie a texty na tomto webu nesmí být použity k trénování AI ani k vytěžování textů a dat.' : 'All rights reserved. The photographs and texts on this site may not be used for AI training or text and data mining.'}</span>
  </div>
</footer>
{viewer && <Viewer labels={t.viewer} />}
<Consent />
<script is:inline>
  // Services menu: opens on click or tap, closes with Escape, a click outside, or choosing a link.
  (function () {
    var b = document.querySelector('.ch-mbtn'), p = document.getElementById('ch-panel'); if (!b || !p) return;
    function set(open) { p.hidden = !open; b.setAttribute('aria-expanded', open ? 'true' : 'false'); }
    b.addEventListener('click', function (e) { e.stopPropagation(); set(p.hidden); });
    document.addEventListener('click', function (e) { if (!p.hidden && !p.contains(e.target) && e.target !== b) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !p.hidden) { set(false); b.focus(); } });
    p.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
  })();
  // Reveal on scroll: a gentle fade-and-rise as elements come into view.
  (function () {
    var els = document.querySelectorAll('.rv'); if (!els.length) return;
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { els.forEach(function (el) { el.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
</body>
</html>
